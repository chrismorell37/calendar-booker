# Google Cloud OAuth (Calendar API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32+ character secret used to encrypt OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Password to access /admin
ADMIN_PASSWORD=change-me

# iron-session cookie encryption (32+ chars)
SESSION_SECRET=change-me-to-another-long-random-string

# Public site URL (used when copying booking links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required on Vercel (and recommended anywhere hosted). Free at https://turso.tech
# Locally, omit these to use data/booking.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
